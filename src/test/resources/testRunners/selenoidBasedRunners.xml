<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Opencart App Test sanity Suite" verbose="4"
	thread-count="10" parallel="tests">

	<listeners>
		<listener
			class-name="com.aventstack.chaintest.plugins.ChainTestListener" />
		<listener class-name="com.qa.opencart.listeners.TestAllureListener" />
		<!--		<listener
		class-name="com.qa.opencart.listeners.AnnotationTransformer" />-->
	</listeners>

	<test name="Login Page Test_chrome">
		<parameter name="browser" value="chrome" />
		<parameter name="browserVersion" value="126.0" />
		<parameter name="testname" value="Login Page Test on chrome 126.0" />
		<classes>
			<class name="com.qa.opencart.tests.LoginPageTest" />
		</classes>
	</test>


	<test name="Account Page Test_firefox105.0">
		<parameter name="browser" value="firefox" />
		<parameter name="browserVersion" value="105.0" />
		<parameter name="testname" value="Login Page Test on firefox 105.0" />
		<classes>
			<class name="com.qa.opencart.tests.AccountPageTest" />
		</classes>
	</test>


	<test name="Product Info PageTest_chrome124.0">
		<parameter name="browser" value="chrome" />
		<parameter name="browserVersion" value="124.0" />
		<parameter name="testname" value="Product Info Page Test on chrome 105.0" />
		<classes>
			<class name="com.qa.opencart.tests.ProductInfoPageTest" />

		</classes>
	</test>

	<test name="Product Info PageTest_chrome125.0">
		<parameter name="browser" value="firefox" />
		<parameter name="browserVersion" value="125.0" />
		<parameter name="testname" value="Product Info PageTest on firefox 125.0" />
		<classes>
			<class name="com.qa.opencart.tests.ProductInfoPageTest" />

		</classes>
	</test>


</suite>	